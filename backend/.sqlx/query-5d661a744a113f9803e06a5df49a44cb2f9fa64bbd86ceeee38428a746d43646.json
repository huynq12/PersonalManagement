{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO tasks (user_id, date, title, sort_order)\n        VALUES (\n            $1, $2, $3,\n            (SELECT COALESCE(max(sort_order) + 1, 0) FROM tasks WHERE user_id = $1 AND date = $2)\n        )\n        RETURNING id, date, title, is_done, done_at, sort_order, created_at\n        ",
