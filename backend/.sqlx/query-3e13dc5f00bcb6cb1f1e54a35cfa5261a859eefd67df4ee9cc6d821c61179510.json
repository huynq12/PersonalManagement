{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, weekdays, sort_order, archived_at, created_at,\n               habit_current_streak(id, weekdays, user_today($1, $3)) AS \"current_streak!\"\n        FROM habits\n        WHERE user_id = $1 AND ($2 OR archived_at IS NULL)\n        ORDER BY sort_order, created_at\n        ",
