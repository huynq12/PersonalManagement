{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.kind, c.id, c.name, c.color, sum(t.amount)::int8 AS \"total!\"\n        FROM transactions t\n        JOIN finance_categories c ON c.id = t.category_id\n        WHERE t.user_id = $1\n          AND t.date >= $2 AND t.date < ($2::date + interval '1 month')::date\n        GROUP BY c.id\n        ORDER BY c.kind, 5 DESC, lower(c.name), c.id\n        ",
