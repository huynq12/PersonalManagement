  "query": "\n        SELECT id, subject_id, status, planned_minutes, started_at, ended_at,\n               duration_seconds, local_date\n        FROM study_sessions\n        WHERE user_id = $1 AND local_date BETWEEN $2 AND $3\n        ORDER BY started_at DESC, id\n        ",
