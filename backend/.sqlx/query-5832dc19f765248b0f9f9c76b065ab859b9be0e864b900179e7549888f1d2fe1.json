  "query": "\n        UPDATE users\n        SET display_name = COALESCE($2, display_name),\n            timezone = COALESCE($3, timezone),\n            locale = COALESCE($4, locale),\n            currency = COALESCE($5, currency)\n        WHERE id = $1\n        RETURNING id, email::text AS \"email!\", password_hash, display_name, timezone, locale,\n                  currency\n        ",
