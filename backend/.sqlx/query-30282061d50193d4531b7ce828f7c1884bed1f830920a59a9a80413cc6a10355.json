{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, c.kind, t.amount, t.date, t.note, t.created_at,\n               c.id AS category_id, c.name AS category_name, c.color AS category_color\n        FROM transactions t\n        JOIN finance_categories c ON c.id = t.category_id\n        WHERE t.id = $2 AND t.user_id = $1\n        ",
