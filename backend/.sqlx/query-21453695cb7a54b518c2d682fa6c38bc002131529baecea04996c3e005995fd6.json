{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email::text AS \"email!\", u.password_hash, u.display_name, u.timezone,\n               u.locale, u.currency\n        FROM users u\n        JOIN oauth_accounts o ON o.user_id = u.id\n        WHERE o.provider = $1 AND o.provider_user_id = $2\n        ",
