# Copy to .env for local development. Never commit .env.

# Database used by tests, `sqlx migrate`, and `cargo sqlx prepare`. Matches docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Database used by the running app (`cargo run`). Optional: falls back to DATABASE_URL.
# For Supabase use the "Session pooler" URI (port 5432), not the transaction pooler (6543).
# APP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

PORT=8080

# Origin of the frontend: allowed by CORS and used for redirects after Google sign-in.
CORS_ORIGIN=http://localhost:5173

# Signs access tokens (HS256). At least 32 bytes; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes

# Set to true behind HTTPS: cookies become `Secure; SameSite=None`.
COOKIE_SECURE=false

# Google OAuth client (Google Cloud console > Google Auth Platform > Clients).
# Leave GOOGLE_CLIENT_ID empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
